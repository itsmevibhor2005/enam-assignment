# Copy to .env and fill in one API key. Everything else has a working default.

# --- model provider -------------------------------------------------------
# gemini | anthropic | openai | groq | openrouter | null
# 'null' runs the whole product without a model: rules-only classification,
# category-weight ranking, no summaries or extraction. Useful for a demo on a
# throttled network, and for the test suite.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# Tiering. Cheap handles bulk classification, summaries and guidance
# extraction; strong handles results numbers and promise adjudication.
LLM_MODEL_CHEAP=gemini-2.5-flash-lite
LLM_MODEL_STRONG=gemini-2.5-flash

# Other providers, if you switch LLM_PROVIDER:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- data sourcing --------------------------------------------------------
# hybrid : scrape live, fall back to captured fixtures per source on failure
# live   : scrape only, fail loudly
# seed   : fixtures only, no outbound calls
DATA_MODE=hybrid

# --- alert defaults (the user can change these in the app) ----------------
DEFAULT_VOLUME_MULTIPLE=2.0
DEFAULT_PRICE_MOVE_PCT=4.0

# --- plumbing -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000
SCHEDULER_ENABLED=true
INGEST_HOUR_IST=19
